+      "expected": {
+        "paymentRoute": "wallet",
+        "primaryTeam": "Payment Provider Fraud",
+        "retainAuditHistory": true
+      }
+    },
+    {
+      "id": "accept_persists",
+      "input": "A frontline worker accepted the primary recommendation and reopened the case.",
+      "expected": {
+        "reviewStatePersists": true,
+        "originalRecommendationVisible": true,
+        "notSent": true
+      }
+    },
