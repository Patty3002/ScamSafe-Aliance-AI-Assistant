{
  "name": "scamsafe-alliance-assistant",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:policy": "node scripts/check-policy.mjs",
    "prebuild": "node scripts/check-policy.mjs",
    "pretest": "node scripts/check-policy.mjs",
    "eval:live": "node scripts/evaluate-provider.mjs",
    "eval:e2e": "node scripts/run-live-e2e.mjs",
    "eval:e2e:score": "vitest run src/liveEvaluation.test.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.2.1",
    "docx": "^9.15.2",
    "lucide-react": "1.69.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.6"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "31.0.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
