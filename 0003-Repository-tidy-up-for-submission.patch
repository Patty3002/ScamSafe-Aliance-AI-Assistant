+      "id": "malformed_model_result",
+      "input": "Model response sets P3 for a report of immediate danger.",
+      "expected": {
+        "validatorMustReject": true,
+        "mustNotDisplayAsValidP3": true
+      }
+    },
+    {
+      "id": "api_failure",
+      "input": "Gemini response is invalid JSON during case analysis.",
+      "expected": {
+        "analysisModeNotRealAI": true,
+        "mustNotSilentlyMarkP3": true
+      }
+    }
+  ]
